# TheMovie App - Environment Variables

# Clerk Authentication (Required)
# Get your key from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Clerk server key (Required for account database sync and revocable shared lists).
# Must belong to the same Clerk instance as the publishable key above.
# Never expose this with NEXT_PUBLIC_.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# TMDB API (Recommended - Primary API)
# Get your key from: https://www.themoviedb.org/settings/api
# TMDB provides: trending movies, trailers, cast, collections, reviews, and more
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# OMDB API (Optional - Fallback and additional data)
# Get your key from: https://www.omdbapi.com/apikey.aspx
# OMDB provides: awards, box office, IMDb/Rotten Tomatoes ratings
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key_here

# TasteDive API (Optional - similar TV fallback)
NEXT_PUBLIC_TASTEDIVE_API_KEY=your_tastedive_api_key_here

# PostgreSQL account storage (server only). Use the provider's pooled TLS URL.
DATABASE_URL=postgresql://user:password@host:5432/themovie?sslmode=require

# Private stable HMAC key for pseudonymous offline feedback exports (server only).
# Generate locally; never commit this secret or put it in NEXT_PUBLIC_.
ML_EXPORT_SECRET=replace_with_a_random_private_secret

# Clerk user.deleted webhook signing secret (server only).
CLERK_WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here
